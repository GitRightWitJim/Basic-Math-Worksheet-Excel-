Option Explicit

Public Sub GenerateSudokuPuzzle()

    ' Fixed board location: Y12:AG20
    Dim boardRange As Range
    Set boardRange = Range("Y12:AG20")

    Randomize

    Dim grid(1 To 9, 1 To 9) As Integer

    If Not FillGrid(grid) Then
        MsgBox "Failed to generate Sudoku.", vbExclamation
        Exit Sub
    End If

    ' Difficulty selection
    Dim choice As Variant
    Dim cluesTarget As Long

    choice = Application.InputBox( _
        "Choose Sudoku Difficulty:" & vbCrLf & vbCrLf & _
        "1 = Easy (42 clues)" & vbCrLf & _
        "2 = Medium (35 clues)" & vbCrLf & _
        "3 = Hard (28 clues)", _
        "Sudoku Difficulty", 2)

    If choice = False Then Exit Sub

    Select Case CLng(choice)
        Case 1
            cluesTarget = 42
        Case 2
            cluesTarget = 35
        Case 3
            cluesTarget = 28
        Case Else
            cluesTarget = 35
    End Select

    ' Remove numbers while keeping unique solution
    DigHolesUnique grid, cluesTarget

    ' Output puzzle only
    boardRange.ClearContents
    boardRange.Font.Size = 11

    Dim r As Long, c As Long

    For r = 1 To 9
        For c = 1 To 9

            If grid(r, c) = 0 Then
                boardRange.cells(r, c).Value = ""
            Else
                boardRange.cells(r, c).Value = grid(r, c)
            End If

        Next c
    Next r

    MsgBox "Sudoku puzzle generated in Y12:AG20", vbInformation

End Sub

'====================================================
' Generate full valid Sudoku solution
'====================================================
Private Function FillGrid(ByRef g() As Integer) As Boolean

    Dim r As Long, c As Long

    If Not FindEmpty(g, r, c) Then
        FillGrid = True
        Exit Function
    End If

    Dim nums(1 To 9) As Integer
    MakeShuffledDigits nums

    Dim i As Long
    Dim n As Integer

    For i = 1 To 9

        n = nums(i)

        If IsValidMove(g, r, c, n) Then

            g(r, c) = n

            If FillGrid(g) Then
                FillGrid = True
                Exit Function
            End If

            g(r, c) = 0

        End If

    Next i

    FillGrid = False

End Function

Private Function FindEmpty(ByRef g() As Integer, ByRef r As Long, ByRef c As Long) As Boolean

    For r = 1 To 9
        For c = 1 To 9

            If g(r, c) = 0 Then
                FindEmpty = True
                Exit Function
            End If

        Next c
    Next r

    FindEmpty = False

End Function

Private Function IsValidMove(ByRef g() As Integer, ByVal r As Long, ByVal c As Long, ByVal n As Integer) As Boolean

    Dim i As Long

    ' Row check
    For i = 1 To 9
        If g(r, i) = n Then Exit Function
    Next i

    ' Column check
    For i = 1 To 9
        If g(i, c) = n Then Exit Function
    Next i

    ' Box check
    Dim br As Long
    Dim bc As Long
    Dim rr As Long
    Dim cc As Long

    br = ((r - 1) \ 3) * 3 + 1
    bc = ((c - 1) \ 3) * 3 + 1

    For rr = br To br + 2
        For cc = bc To bc + 2

            If g(rr, cc) = n Then Exit Function

        Next cc
    Next rr

    IsValidMove = True

End Function

Private Sub MakeShuffledDigits(ByRef nums() As Integer)

    Dim i As Long

    For i = 1 To 9
        nums(i) = i
    Next i

    Dim j As Long
    Dim tmp As Integer

    For i = 9 To 2 Step -1

        j = Int(Rnd() * i) + 1

        tmp = nums(i)
        nums(i) = nums(j)
        nums(j) = tmp

    Next i

End Sub

'====================================================
' Remove numbers while preserving unique solution
'====================================================
Private Sub DigHolesUnique(ByRef g() As Integer, ByVal cluesTarget As Long)

    Dim cells(1 To 81, 1 To 2) As Long

    Dim idx As Long
    Dim r As Long
    Dim c As Long

    idx = 0

    For r = 1 To 9
        For c = 1 To 9

            idx = idx + 1
            cells(idx, 1) = r
            cells(idx, 2) = c

        Next c
    Next r

    ShuffleCells cells

    Dim clues As Long
    clues = 81

    Dim saved As Integer
    Dim attempts As Long

    For idx = 1 To 81

        If clues <= cluesTarget Then Exit For

        r = cells(idx, 1)
        c = cells(idx, 2)

        saved = g(r, c)
        g(r, c) = 0

        Dim copyGrid(1 To 9, 1 To 9) As Integer
        CopyGridValues g, copyGrid

        If CountSolutions(copyGrid, 2) <> 1 Then
            g(r, c) = saved
        Else
            clues = clues - 1
        End If

        attempts = attempts + 1

        If attempts > 500 Then Exit For

    Next idx

End Sub

Private Sub ShuffleCells(ByRef cells() As Long)

    Dim i As Long
    Dim j As Long

    Dim tr As Long
    Dim tc As Long

    For i = 81 To 2 Step -1

        j = Int(Rnd() * i) + 1

        tr = cells(i, 1)
        tc = cells(i, 2)

        cells(i, 1) = cells(j, 1)
        cells(i, 2) = cells(j, 2)

        cells(j, 1) = tr
        cells(j, 2) = tc

    Next i

End Sub

'====================================================
' Count solutions
'====================================================
Private Function CountSolutions(ByRef g() As Integer, ByVal cap As Long) As Long

    Dim r As Long
    Dim c As Long

    If Not FindEmpty(g, r, c) Then
        CountSolutions = 1
        Exit Function
    End If

    Dim nums(1 To 9) As Integer
    MakeShuffledDigits nums

    Dim i As Long
    Dim n As Integer
    Dim total As Long

    For i = 1 To 9

        n = nums(i)

        If IsValidMove(g, r, c, n) Then

            g(r, c) = n

            total = total + CountSolutions(g, cap)

            If total >= cap Then
                g(r, c) = 0
                CountSolutions = total
                Exit Function
            End If

            g(r, c) = 0

        End If

    Next i

    CountSolutions = total

End Function

Private Sub CopyGridValues(ByRef src() As Integer, ByRef dst() As Integer)

    Dim r As Long
    Dim c As Long

    For r = 1 To 9
        For c = 1 To 9

            dst(r, c) = src(r, c)

        Next c
    Next r

End Sub




